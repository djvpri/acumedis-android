<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sesi terapi baru"
                android:textColor="@color/fg"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Pilih pasien"
                android:textColor="@color/muted"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/FieldLabel"
                android:text="Pasien" />

            <TextView
                android:id="@+id/pickPatient"
                style="@style/FieldInput"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_chevron"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:text="Pilih pasien" />

            <TextView
                style="@style/FieldLabel"
                android:text="Keluhan utama" />

            <EditText
                android:id="@+id/complaint"
                style="@style/FieldInput"
                android:hint="Contoh: nyeri punggung bawah"
                android:importantForAutofill="no"
                android:inputType="textCapSentences" />

            <TextView
                style="@style/FieldLabel"
                android:text="Warna / kondisi lidah" />

            <EditText
                android:id="@+id/tongue"
                style="@style/FieldInput"
                android:hint="mis. pucat, tebal di tengah"
                android:importantForAutofill="no"
                android:inputType="textCapSentences" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/takePhoto"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Foto lidah"
                    android:textColor="@color/primary_deep"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pickPhoto"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Dari galeri"
                    android:textColor="@color/primary_deep"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/tonguePreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:contentDescription="Foto lidah"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/aiBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_ai"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="Saran AI"
                    android:textColor="@color/primary_deep"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/aiText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/fg2"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/aiUse"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Pakai saran ini"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                style="@style/FieldLabel"
                android:text="Skala nyeri (0-10)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/pain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="10"
                    android:progress="5" />

                <TextView
                    android:id="@+id/painLabel"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="5/10"
                    android:textColor="@color/fg"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/FieldLabel"
                android:text="Titik terapi" />

            <EditText
                android:id="@+id/points"
                style="@style/FieldInput"
                android:hint="mis. LI4, LI15, GB21"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters" />

            <TextView
                android:id="@+id/suggestPoints"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Saran titik dari AI"
                android:textColor="@color/primary_deep"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                style="@style/FieldLabel"
                android:text="Durasi (menit)" />

            <EditText
                android:id="@+id/duration"
                style="@style/FieldInput"
                android:hint="30"
                android:importantForAutofill="no"
                android:inputType="number" />

            <TextView
                style="@style/FieldLabel"
                android:text="Catatan" />

            <EditText
                android:id="@+id/notes"
                style="@style/FieldInput"
                android:gravity="top|start"
                android:hint="Observasi, anjuran, dsb"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3" />

            <TextView
                style="@style/FieldLabel"
                android:text="Biaya" />

            <EditText
                android:id="@+id/fee"
                style="@style/FieldInput"
                android:hint="150000"
                android:importantForAutofill="no"
                android:inputType="number" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/paid"
                    style="@style/Chip"
                    android:text="Sudah dibayar" />

                <TextView
                    android:id="@+id/unpaid"
                    style="@style/Chip"
                    android:text="Belum dibayar" />
            </LinearLayout>

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/red"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Simpan sesi"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
