<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Masuk ke AcuMedis"
            android:textColor="@color/fg"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rekam medis klinik dalam genggaman"
            android:textColor="@color/muted"
            android:textSize="12.5sp" />

        <TextView
            style="@style/FieldLabel"
            android:text="Alamat server" />

        <EditText
            android:id="@+id/baseUrl"
            style="@style/FieldInput"
            android:hint="https://klinik.contoh.com"
            android:inputType="textUri"
            android:importantForAutofill="no" />

        <TextView
            style="@style/FieldLabel"
            android:text="Email" />

        <EditText
            android:id="@+id/email"
            style="@style/FieldInput"
            android:hint="dokter@klinik.com"
            android:inputType="textEmailAddress"
            android:importantForAutofill="no" />

        <TextView
            style="@style/FieldLabel"
            android:text="Password" />

        <EditText
            android:id="@+id/password"
            style="@style/FieldInput"
            android:hint="••••••••"
            android:inputType="textPassword"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/loginBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Masuk"
            android:textColor="#FFFFFF"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
